# Django 密钥 - 生产环境必须修改为强随机密钥
DJANGO_SECRET_KEY=your-strong-secret-key-here-change-in-production

# Django 配置
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com

# 数据库路径（生产环境）
DJANGO_DB_PATH=/app/data/db.sqlite3

# DeepSeek API Key（仅开发辅助使用，非平台运行必需）
DEEPSEEK_API_KEY=
