# Django 密钥 - 生产环境必须修改为强随机密钥
DJANGO_SECRET_KEY=your-strong-secret-key-here-change-in-production

# Django 配置
DJANGO_SETTINGS_MODULE=config.settings.production
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,your-domain.com
DJANGO_SECURE_SSL_REDIRECT=false
DJANGO_LOG_FILE=/app/logs/django.log

# 数据库路径（生产环境）
DJANGO_DB_PATH=/app/data/db.sqlite3

# 自动备份时间（Asia/Shanghai，HH:MM）
BACKUP_DAILY_TIME=02:30
BACKUP_WEEKLY_TIME=03:00
BACKUP_MONTHLY_TIME=03:30
AI_EXAM_MAX_FILE_SIZE=20971520
AI_EXAM_MAX_PAGES=30
AI_EXAM_MAX_TEXT_CHARS=60000
AI_EXAM_OCR_LANG=chi_sim+eng

# DeepSeek API Key（仅从服务器环境变量读取，不写入数据库或备份）
DEEPSEEK_API_KEY=
